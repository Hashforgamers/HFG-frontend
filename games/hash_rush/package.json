{
  "name": "hash-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "vitest run tests/balance.report.test.ts --reporter=verbose",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5184",
    "assets": "blender --background --python tools/build_assets.py"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
